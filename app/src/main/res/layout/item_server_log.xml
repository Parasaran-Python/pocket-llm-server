<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/bg_card_secondary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_log_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_block"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="POST"
                android:textColor="@color/primary_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/tv_log_method"
                android:fontFamily="monospace"
                android:text="/v1/chat/completions"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_log_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_gpu"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="200 OK"
                android:textColor="@color/gpu_badge_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_log_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.50 • 120 tokens • 24.5 t/s • 4.8s"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_log_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="14:23:05"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
